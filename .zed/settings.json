{
    "format_on_save": "on",
    "formatter": "language_server",
    "tab_size": 4,
    "hard_tabs": false,
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "file_types": {
        "YAML": [".clang-format", ".clangd"]
    },
    "file_scan_exclusions": ["**/.git", "**/.DS_Store", "build-*", ".cache", ".venv"],
    "languages": {
        "C++": {
            "language_servers": ["clangd"],
            "formatter": {
                "language_server": {
                    "name": "clangd"
                }
            }
        },
        "Python": {
            "language_servers": ["ty", "ruff"],
            "formatter": {
                "language_server": {
                    "name": "ruff"
                }
            }
        }
    },
    "lsp": {
        "clangd": {
            "binary": {
                "path": "mise",
                "arguments": ["x", "--", "clangd"]
            }
        },
        "ruff": {
            "binary": {
                "path": "mise",
                "arguments": ["x", "--", "ruff", "server"]
            }
        },
        "ty": {
            "binary": {
                "path": "mise",
                "arguments": ["x", "--", "ty", "server"]
            }
        }
    }
}
